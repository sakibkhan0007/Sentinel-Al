# Redis Caching & Coordination (Optional, fallback is active in-memory store):
# REDIS_URL=redis://127.0.0.1:6379/0

# AI Copilot Configuration:
# Leave empty to run with high-accuracy Deterministic Local Fallback (English & Hinglish)
# Or provide your official OpenAI API key:
OPENAI_API_KEY=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
